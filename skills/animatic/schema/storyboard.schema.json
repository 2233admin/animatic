{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/2233admin/animatic/skills/animatic/schema/storyboard.schema.json",
  "title": "animatic storyboard",
  "description": "Editor help only. scripts/lib/storyboard.mjs is the check that counts: it also verifies files exist, captions fit and every shot can be read in time.",
  "type": "object",
  "required": [
    "takeaway",
    "shots"
  ],
  "properties": {
    "takeaway": {
      "type": "string",
      "description": "The one sentence the viewer should remember. Never shown."
    },
    "title": {
      "type": "string"
    },
    "lang": {
      "type": "string",
      "default": "zh-CN"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "caption"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "scene",
              "clip",
              "image",
              "compare"
            ]
          },
          "caption": {
            "type": "string",
            "description": "One short line: what the picture means."
          },
          "html": {
            "type": "string",
            "description": "scene: path to an HTML fragment using the diagram kit"
          },
          "src": {
            "type": "string",
            "description": "clip/image: path to a real capture"
          },
          "trim": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "before": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "beforeLabel": {
            "type": "string"
          },
          "afterLabel": {
            "type": "string"
          },
          "hold": {
            "type": "number",
            "description": "Seconds fully on screen. Can only lengthen the computed reading time."
          },
          "highlight": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "x",
                "y"
              ],
              "properties": {
                "text": {
                  "type": "string"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "scene"
                }
              }
            },
            "then": {
              "required": [
                "html"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "clip",
                    "image"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "src"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "compare"
                }
              }
            },
            "then": {
              "required": [
                "before",
                "after"
              ]
            }
          }
        ]
      }
    },
    "pr": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer"
        }
      }
    },
    "doc": {
      "type": "object",
      "description": "ark style: what the document says about itself",
      "properties": {
        "issuer": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "index": {
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      }
    }
  }
}